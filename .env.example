# ---------------------------------------------------------------------------
# Django core
# ---------------------------------------------------------------------------
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=replace-me-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=

# Used in QR codes, share links and Open Graph URLs.
# Leave blank locally to use the current request host.
SITE_URL=
SITE_NAME=To My Love
DJANGO_TIME_ZONE=UTC

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Leave blank for SQLite (db.sqlite3). Examples:
#   DATABASE_URL=postgres://tomylove:secret@localhost:5432/tomylove
#   DATABASE_URL=mysql://tomylove:secret@localhost:3306/tomylove
DATABASE_URL=
# Require SSL for PostgreSQL connections.
DB_SSL=False

# ---------------------------------------------------------------------------
# Cache — used for login and letter-password throttling.
# ---------------------------------------------------------------------------
# Default is in-process memory. For multiple workers/instances use Redis:
#   REDIS_URL=redis://localhost:6379/1
CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache
CACHE_LOCATION=to-my-love
REDIS_URL=

# ---------------------------------------------------------------------------
# Email (console by default; configure SMTP in production)
# ---------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=hello@tomylove.example
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# ---------------------------------------------------------------------------
# HTTPS / security (only applied when DJANGO_DEBUG=False)
# ---------------------------------------------------------------------------
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_HSTS_SECONDS=31536000
